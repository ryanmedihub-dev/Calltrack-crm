PORT=5000
MONGO_URI=

JWT_SECRET=
ALLOWED_ORIGINS=http://localhost:3000

# Pusher — get from pusher.com/dashboard
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

OPENAI_API_KEY=

META_WEBHOOK_TOKEN=
META_VERIFY_TOKEN=

# Feature flags — see config/features.js
FEATURE_LEAD_POOL=false
FEATURE_AUTO_LEAD_CREATE_ON_CALL=false

# Redis — speed layer over Mongo, fail-open if unset/down. See lib/redis.js.
REDIS_URL=redis://127.0.0.1:6379
CACHE_VERSION=v1
DEBUG_SYNC_SKIPS=0
